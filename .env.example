# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/borsoga_prospector"

# ─── Google Places ───────────────────────────────────────────────────────────
# La cuota es un recurso escaso y visible en la interfaz: cachea details por
# placeId con caducidad de 30 dias y no vuelvas a pedir lo que ya tienes.
# Solo la usa el worker. El mapa del front no necesita ninguna clave: son tiles
# vectoriales de OpenFreeMap y el estilo se genera desde los tokens del tema.
GOOGLE_PLACES_API_KEY=""
PLACES_MONTHLY_LIMIT="10000"
PLACES_CACHE_TTL_DAYS="30"

# ─── Proveedor de LLM ────────────────────────────────────────────────────────
# claude-code-local: Agent SDK contra la suscripcion Max, en el worker local.
# anthropic-api:     API de pago, para cuando esto sea multiusuario.
LLM_PROVIDER="claude-code-local"
ANTHROPIC_API_KEY=""                # solo necesario con LLM_PROVIDER=anthropic-api
LLM_MODEL="claude-opus-5"
LLM_MAX_TURNS="40"                  # tope de vueltas del bucle agentico por prospecto
# Con anthropic-api esto es dinero. Con claude-code-local es una cifra nocional
# a precio de tarifa contra la suscripcion, e incluye la escritura de cache del
# prefijo del harness (una vez por hora, no por prospecto). Por debajo de ~1,50
# la primera auditoria de cada hora se queda sin presupuesto a mitad.
LLM_MAX_COST_USD_PER_PROSPECT="2.50"

# ─── Cola de trabajos ────────────────────────────────────────────────────────
# "pg" usa la tabla jobs con SKIP LOCKED (cero infraestructura extra).
QUEUE_DRIVER="pg"
REDIS_URL=""
WORKER_CONCURRENCY="2"

# ─── Buena vecindad en el crawling ───────────────────────────────────────────
CRAWL_USER_AGENT="BorsogaProspector/0.1 (+https://borsoga.studio/bot)"
CRAWL_REQUESTS_PER_SECOND="1"
CRAWL_MAX_PAGES_PER_SITE="25"
CRAWL_RESPECT_ROBOTS="true"

# ─── Almacenamiento de capturas ──────────────────────────────────────────────
STORAGE_DRIVER="local"              # local | s3
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET=""
S3_REGION=""

# ─── Datos personales ────────────────────────────────────────────────────────
# La ficha de personas guarda email y telefono, algunos inferidos.
PII_MASK_PHONES_BY_DEFAULT="true"
PII_RETENTION_DAYS="365"
